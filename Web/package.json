{
	"name": "web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 9091 --host 0.0.0.0",
		"build": "vite build",
		"preview": "vite preview --port 9091 --host 0.0.0.0",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vitest run --configLoader runner",
		"test:e2e": "node e2e/run-playwright.mjs",
		"format": "node ./node_modules/prettier/bin/prettier.cjs --write .",
		"format:staged": "prettier --write --ignore-unknown",
		"format:check": "node ./node_modules/prettier/bin/prettier.cjs --check .",
		"lint": "npm run format:check && npm run lint:eslint",
		"lint:eslint": "eslint ."
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.0",
		"@eslint/js": "^10.0.1",
		"@playwright/mcp": "^0.0.79",
		"@playwright/test": "^1.62.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.2",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/svelte": "^5.4.2",
		"@testing-library/user-event": "^14.6.3",
		"@types/node": "^26.2.0",
		"eslint": "^10.8.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.22.0",
		"globals": "^17.9.0",
		"jsdom": "^30.0.1",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"svelte": "^5.56.8",
		"svelte-check": "^4.7.5",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.66.0",
		"vite": "^8.2.1",
		"vitest": "^4.1.10"
	},
	"dependencies": {
		"@fontsource/cinzel": "5.3.0",
		"@fontsource/im-fell-english": "5.3.0",
		"@lucide/svelte": "^1.30.0",
		"pocketbase": "0.27.1"
	}
}
